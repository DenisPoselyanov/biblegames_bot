# URL сервера Kahoot (клієнт)
VITE_SERVER_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001

# Telegram admin bot (npm run bot)
BOT_TOKEN=123456:ABC-DEF...
# Твій Telegram user id (через @userinfobot), через кому для кількох адмінів
ADMIN_IDS=123456789

# Ollama (локальна AI)
OLLAMA_MODEL=mistral
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Server storage provider:
# json (default) | sql
STORAGE_PROVIDER=json

# Required when STORAGE_PROVIDER=sql (Postgres/Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/bible_game
# Optional SSL switch for managed DBs
PG_SSL=false
