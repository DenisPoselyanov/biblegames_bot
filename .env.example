# URL сервера Kahoot (клієнт + REST API)
VITE_SERVER_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001
# Telegram bot username for Kahoot startapp links (t.me/BOT?startapp=kahoot_CODE)
VITE_BOT_USERNAME=biblegames_bot
# Telegram user ids allowed to edit practice stage caps when PRACTICE_STAGE_CAPS_PUBLIC_EDIT=false
VITE_ADMIN_IDS=123456789

# Feature flag overrides for dev/QA (registry: src/lib/flags.ts), true/false — unset uses the registry default
# VITE_FLAG_LEARNING_FIRST_NAVIGATION=true
# VITE_FLAG_TODAY_DASHBOARD=true
# VITE_FLAG_DAILY_PLAN_V2=true
# VITE_FLAG_LEARNING_PLANS=true
# VITE_FLAG_LESSON_EXPERIENCE_V2=true
# VITE_FLAG_REVIEW_SCHEDULER_V2=true
# VITE_FLAG_PROGRESS_DASHBOARD_V2=true

# --- Phase 1 auth (server/config/env.ts) ---
# Verifies Telegram Web App initData (t.me BotFather → your bot → API token). REQUIRED in production.
TELEGRAM_BOT_TOKEN=
# telegram (default, fail-closed) | development (insecure fixture identity from x-user-id; blocked in production)
AUTH_MODE=telegram
# Max accepted age of Telegram auth_date, seconds (default 86400)
# AUTH_INITDATA_MAX_AGE_SEC=86400
#
# Phase 1 WS4 part 2 removed the rollout break-glass flags — fail-closed Telegram
# auth, RBAC, and server-authoritative progression are now unconditional. The
# flags FEATURE_AUTHV2 / FEATURE_SECUREKAHOOTIDENTITY / FEATURE_RBACV2 /
# FEATURE_AUTHORITATIVEPROFILEV2 / FEATURE_DISABLELEGACYPROFILEWRITES /
# FEATURE_SERVER_STREAK no longer have any effect.

# --- Phase 1 RBAC (WS2, server/authz/) ---
# Server-side role grants. JSON: {"<telegramUserId>":["admin"],"<id>":["content_reviewer"]}
# Roles: user (implicit) | group_leader | content_reviewer | content_publisher | support | admin
# RBAC_ROLE_GRANTS={"123456789":["admin"]}
# Shortcut: comma-separated user ids granted the admin role (merged with RBAC_ROLE_GRANTS)
# RBAC_ADMIN_IDS=123456789
# Allow /api/admin/questions to write question JSON files directly in production (default: blocked)
# QUESTION_ADMIN_FS_WRITES=false

# --- Phase 1 server-authoritative progression (server/wallet + server/progression) ---
# The wallet ledger and the /api/v1 command surface are always on:
#   POST /api/v1/progression/completions  (coins/wisdom/rank/streak/achievements/practice tracks)
#   POST /api/v1/progression/answers      (study mastery)
#   POST /api/v1/shop/purchases           (theme/avatar spend via the wallet ledger)
#   PATCH /api/v1/me/preferences          (whitelisted preference writes — the only client write)
#   PATCH /api/v1/me/learning-state       (client-owned reviewSchedules blob, §7.4 exception)
#   POST /api/v1/me/migrate               (one-time bounded legacy import)
# There is no whole-profile PUT — the client cannot set coins/rank/streak/... as final values.
# Max coins a one-time legacy migration will credit; excess is capped and recorded.
# MIGRATION_MAX_COINS=100000

# --- Phase 1 abuse controls + demo isolation (WS4 part 2) ---
# Rate limiting is on by default (in-memory, per principal-or-IP). Set to true to disable it.
# RATE_LIMIT_DISABLED=false
# Demo/in-memory routes (/study/path, /dashboard, /leaderboard) — on off-production only,
# impossible under NODE_ENV=production. Set to false to also turn them off in dev.
# DEMO_ROUTES_ENABLED=true

# Server CORS / production. Comma-separated; CLIENT_ORIGINS (plural) also accepted. No localhost in production.
CLIENT_ORIGIN=https://your-mini-app.vercel.app
PORT=3001

# Bolls.life (текст Писання на сервері)
BOLLS_API_BASE=https://bolls.life
BOLLS_DEFAULT_TRANSLATION=UTT
BOLLS_CACHE_TTL_MS=259200000
BOLLS_CACHE_MAX=500
BOLLS_FETCH_TIMEOUT_MS=12000

# Telegram admin bot (npm run bot)
BOT_TOKEN=123456:ABC-DEF...
# Твій Telegram user id (через @userinfobot), через кому для кількох адмінів
ADMIN_IDS=123456789

# AI-провайдер для скриптів і GUI (ollama | gemini | omniroute)
AI_PROVIDER=ollama
AI_MODEL=mistral

# Ollama (локальна AI)
OLLAMA_MODEL=mistral
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Gemini (Google AI Studio — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OmniRoute (локальний шлюз OpenAI API — https://github.com/diegosouzapw/OmniRoute)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# ID моделі або combo з дашборду OmniRoute (Combos → назва, напр. Poselyanov)
OMNIROUTE_MODEL=Poselyanov

# Server storage provider:
# json (local dev only) | sql (Postgres / Supabase — REQUIRED in production, §26.1 / ADR-016)
STORAGE_PROVIDER=json

# Required when STORAGE_PROVIDER=sql — Supabase: Project Settings → Database → Connection string (URI)
# Use Transaction pooler for serverless; enable SSL for managed hosts.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# true for Supabase / other managed Postgres (recommended in production)
PG_SSL=false

# Questions bank: sql (Supabase, default when DATABASE_URL set) | json (local files only)
QUESTIONS_PROVIDER=sql

# --- Phase 2 WS5: legacy profile-blob decomposition (§18.2) ---
# When true, preference writes (activeTheme/avatar/bibleTranslation) go ONLY to the
# typed user_preferences table and the player_profiles blob's copies are frozen.
# Set this AFTER `npm run migrate:backfill-preferences` + a verification window.
# LEGACY_STORE_READONLY=false

# --- Phase 2 WS6: progression / entitlement decomposition (§18.2, ADR-016) ---
# When true, the reward hot path writes ONLY the typed progression_state /
# achievement_grants / player_theme_stats / entitlements tables and the
# player_profiles / player_stats blobs are frozen for those fields.
# Set this AFTER `npm run migrate:backfill-progression -- --verify-only` is clean.
# Migrations 0004-0006 must be applied (`npm run db:migrate`) before deploying this code.
# LEGACY_PROGRESSION_READONLY=false

# --- Phase 2 WS5: background jobs (server/worker.ts, ADR-014) ---
# memory (default, non-durable) | postgres (durable — ADR-014 part 1b, not wired yet: falls back to memory)
# JOB_QUEUE_DRIVER=memory
# Run the recurring maintenance sweeps (rate-limit / idempotency / telemetry retention).
# Set true on the dedicated worker process ONLY. Needs DATABASE_URL.
# JOB_SCHEDULES_ENABLED=false

# --- Phase 2 WS5: object storage (content snapshots + future exports/media, ADR-015) ---
# filesystem (default, single-VPS) | s3 (any S3-compatible: AWS, MinIO, R2, B2)
# OBJECT_STORAGE_DRIVER=filesystem
# OBJECT_STORAGE_DIR=server/.data/objects
# When OBJECT_STORAGE_DRIVER=s3 (incomplete config → warn + fallback to filesystem):
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=biblegames-artifacts
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=
